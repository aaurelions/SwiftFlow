<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld edges selected</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld edge selected</string>
			<key>other</key>
			<string>%lld edges selected</string>
		</dict>
	</dict>
	<key>%lld nodes and %lld edges selected</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@nodes@ and %2$#@edges@ selected</string>
		<key>edges</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%2$lld edge</string>
			<key>other</key>
			<string>%2$lld edges</string>
		</dict>
		<key>nodes</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%1$lld node</string>
			<key>other</key>
			<string>%1$lld nodes</string>
		</dict>
	</dict>
	<key>%lld nodes selected</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld node selected</string>
			<key>other</key>
			<string>%lld nodes selected</string>
		</dict>
	</dict>
</dict>
</plist>
